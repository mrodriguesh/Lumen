    "no_speech": 0.177978515625,
    "compression": 1.4439461883408071
   },
   {
    "start": 100.915,
    "end": 101.505,
    "text": "E onde fica a saída?",
    "logprob": -0.3801577803000663,
    "no_speech": 0.177978515625,
    "compression": 1.4439461883408071
   },
   {
    "start": 101.505,
