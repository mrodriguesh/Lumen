    "compression": 1.4748858447488584
   },
   {
    "start": 7.53,
    "end": 9.33,
    "text": "Pois é do mundo que nenhum país é o suficiente sem tecnologia,",
    "logprob": -0.403947357127541,
    "no_speech": 0.35400390625,
    "compression": 1.4748858447488584
   },
   {
    "start": 9.38,
    "end": 10.73,
    "text": "mas nós sabemos fazer a nossa parte.",
