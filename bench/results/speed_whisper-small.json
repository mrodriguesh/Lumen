    "no_speech": 0.75732421875,
    "compression": 1.5938864628820961
   },
   {
    "start": 96.765,
    "end": 98.265,
    "text": "Tem que fazer a sua maneira, porra",
    "logprob": -0.9104729611594398,
    "no_speech": 0.75732421875,
    "compression": 1.5938864628820961
   },
   {
    "start": 98.265,
    "end": 99.265,
    "text": "A alternativa, porra, petrol",
