    "compression": 1.4874371859296482
   },
   {
    "start": 38.2,
    "end": 42.68,
    "text": "Centenas, mas é um outro desses papers de nome complicadíssimo que vocês aqui vão saber.",
    "logprob": -0.3792134751094861,
    "no_speech": 0.444091796875,
    "compression": 1.4874371859296482
   },
   {
    "start": 42.68,
    "end": 47.25,
    "text": "Me conhecem sem saber, se não soubessem essa história é minha, com certeza pensariam em mim.",
