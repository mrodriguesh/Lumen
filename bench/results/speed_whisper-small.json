    "compression": 1.5724907063197027
   },
   {
    "start": 123.79,
    "end": 129.885,
    "text": "Eu picava no salão cinco horas. Eu usava um creme que tinha um cheiro ouro-roso.",
    "logprob": -0.45680895278124306,
    "no_speech": 0.59228515625,
    "compression": 1.549618320610687
   },
   {
    "start": 129.885,
    "end": 132.385,
    "text": "Essa foi a imagem marcante na história do Trabalho da Comunidade. Foi a invasão da polícia em 2010.",
