    "compression": 1.5045454545454546
   },
   {
    "start": 20.68,
    "end": 25.7,
    "text": "No Brasil, aprenderam como é que faz para ir lá no mar, furar, primeiro, passar mil...",
    "logprob": -0.3137499859929085,
    "no_speech": 0.5595703125,
    "compression": 1.5045454545454546
   },
   {
    "start": 25.7,
    "end": 27.7,
    "text": "Fui de dinâmica, usam computadores para fazer as contas, etc.",
    "logprob": -0.3137499859929085,
